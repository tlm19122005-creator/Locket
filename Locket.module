
#!name=Locket - minhco05
#!desc=Module cấu hình Locket cá nhân
# Maintainer: minhco05

[General]
user-agent = Locket/1.0.0 (iPhone; iOS 26.3; Scale/3.00)
dns-server = https://dns.nextdns.io/e22b26
[Script]
# ~ Locket Gold - Shadowrocket / Surge / LanceX

# RevenueCat Response
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/tlm19122005-creator/Locket/refs/heads/main/locketfix8.js, requires-body=true, max-size=-1, timeout=60

# RevenueCat Request Header
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/tlm19122005-creator/Locket/refs/heads/main/header7.js, timeout=60

# Locket Firebase Remote Config
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/tlm19122005-creator/Locket/refs/heads/main/forceGold4.3.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND%, api.revenuecat.com, firebaseremoteconfig.googleapis.com

[Rule]
# Add your own ordinary domain-routing rules here.

[MITM]
# No MITM hostnames are required for DNS-over-HTTPS itself.
